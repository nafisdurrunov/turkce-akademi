# ============================================================
#  Türkçe Akademi — contoh konfigurasi environment
#  Salin file ini menjadi ".env" lalu isi nilainya.
# ============================================================
#
# 1. Buka https://supabase.com/dashboard → pilih project.
# 2. Project Settings → API Keys (tampilan lama: Project Settings → API).
# 3. Salin "Project URL" dan "Publishable key" (atau "anon public").
#
# Panduan lengkap dari nol: PANDUAN-SUPABASE.md
#
# Tanpa file .env, aplikasi tetap bisa dipakai dalam MODE LOKAL:
# semua progres disimpan di localStorage browser (tanpa sinkron).
#
# CATATAN: kedua nilai ini aman dipublikasikan (publishable/anon key
# memang dirancang untuk browser). Jangan pernah memakai secret key
# ("sb_secret_...") atau "service_role".
# ============================================================

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.contoh-key-anda

# Opsional — hanya untuk build GitHub Pages di subfolder:
# VITE_BASE=/nama-repo/
